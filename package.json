{
  "name": "ccg-twitch-bot",
  "version": "1.1.0",
  "description": "Twitch Bot для игры CCG",
  "main": "public/main.js",
  "homepage": "./",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "react-scripts start",
    "overlay": "node overlay-server.js",
    "test-overlay": "node test-overlay.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:unit": "node test/card-draw.test.js && node test/collections.test.js",
    "seed:cards": "node scripts/seed-test-cards.js",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron-build": "npm run build && cross-env NODE_ENV=production electron-builder"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.11.0",
    "tmi.js": "^1.8.5",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "concurrently": "8.2.1",
    "cross-env": "7.0.3",
    "electron": "27.0.0",
    "electron-builder": "24.6.4",
    "react-scripts": "5.0.1",
    "wait-on": "7.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
